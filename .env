# Local environment variables
JWT_SECRET=CHANGE_ME_DEV_SECRET

# Database configuration
# LOCAL_ONLY MODE: Comment out TURSO_* variables
# REPLICA MODE: Set both DATABASE_PATH (local file) and TURSO_* (remote sync)

# Local database file (used as replica cache)
DATABASE_PATH=zourit.db

# Remote Turso database (for replication)
TURSO_DATABASE_URL=libsql://zourit-suntzu974.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3NjEwNTI0MDcsImlkIjoiODZhZGQ3YTAtZTdkNS00OWJkLTkzZDYtYjQwYWYwMGI3ZDcyIiwicmlkIjoiYTM0ZTZlNDUtZWFlYi00MzU4LWJlNjUtOWEyZjJiNWYzZDZhIn0.R1amWr72X4ZOXNPYnXaM0Zf06ytfhCSTpidcXSWYcD8eN9ltNrPBrwuIwyXesAhfUdPzIgKdGiYFTN0jpI_XAg

# Sync interval in seconds (default: 60)
SYNC_INTERVAL_SECONDS=60

# Max retry interval when remote is offline (default: 300 = 5 minutes)
SYNC_MAX_RETRY_INTERVAL=300

PORT=3000
